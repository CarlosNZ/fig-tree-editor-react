{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* `@fig-tree-editor-react` is a build-time alias (see vite.config.ts) — the
       runtime source is swapped per VITE_FIG_SOURCE. For type-checking, resolve
       it to the library's source so the demo is checked against the in-repo API
       (what `local` mode runs). react/react-dom are pinned to the demo's own
       @types copies: ../src resolves react from the repo-root copy otherwise,
       and two copies clash on React's `unique symbol` ref types.
       `@playground-data` is the data shared with the docs site's Playground
       (vite.config.ts), and fig-tree-evaluator is pinned to the demo's copy,
       which that data would otherwise resolve from the docs site's. */
    "paths": {
      "@fig-tree-editor-react": ["../src"],
      "@playground-data/*": ["../../fig-tree-evaluator/docs-site/src/playground/*"],
      "fig-tree-evaluator": ["./node_modules/fig-tree-evaluator"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
