{
  "name": "fig-tree-demo",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://carlosnz.github.io/fig-tree-evaluator",
  "type": "module",
  "scripts": {
    "serve": "node ./src/express/server",
    "start": "concurrently --kill-others-on-fail \"yarn serve\" \"vite --host\"",
    "start:local": "concurrently --kill-others-on-fail \"yarn serve\" \"VITE_FIG_SOURCE=local vite --host\"",
    "start:build": "concurrently --kill-others-on-fail \"yarn serve\" \"VITE_FIG_SOURCE=build vite --host\"",
    "start:pack": "concurrently --kill-others-on-fail \"yarn serve\" \"VITE_FIG_SOURCE=pack vite --host\"",
    "dev": "yarn start:local",
    "prebuild": "node ./scripts/getVersion.cjs",
    "build": "rimraf dist && vite build && cp -r img dist/",
    "build:local": "VITE_FIG_SOURCE=local yarn build",
    "build:build": "VITE_FIG_SOURCE=build yarn build",
    "build:pack": "VITE_FIG_SOURCE=pack yarn build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "predeploy": "yarn build",
    "deploy": "gh-pages -d dist -r https://github.com/CarlosNZ/fig-tree-evaluator.git"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.1.1",
    "@chakra-ui/react": "^2.8.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "fig-tree-editor-react": "^0.8.4",
    "fig-tree-evaluator": "^2.21.5",
    "framer-motion": "^10.15.1",
    "json-edit-react": "^2.0.0-beta.7",
    "json5": "^2.2.3",
    "markdown-to-jsx": "^7.4.7",
    "pg": "^8.11.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "use-undo": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.4.9",
    "@types/pg": "^8.10.2",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "gh-pages": "^6.1.1",
    "jest": "^29.7.0",
    "react-select": "^5.8.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  }
}
