{
  "name": "fig-tree-editor-react",
  "version": "3.0.0-dev",
  "private": true,
  "description": "React component for constructing FigTree Evaluator expressions",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./style.css": "./build/style.css"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.8.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "author": "Carl Smith <5456533+CarlosNZ@users.noreply.github.com>",
  "repository": "git+https://github.com/CarlosNZ/fig-tree-editor-react.git",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:local-evaluator": "VITE_EVALUATOR_SOURCE=local vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "typecheck:local-evaluator": "tsc -p tsconfig.local-evaluator.json",
    "build": "rimraf ./build && rollup -c && rimraf ./build/dts",
    "size": "node scripts/bundleSize.mjs",
    "check:package": "node scripts/checkPackage.mjs",
    "dev": "pnpm demo:local-evaluator",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "pnpm build",
    "demo": "pnpm -C demo start",
    "demo:local": "pnpm -C demo dev",
    "demo:local-evaluator": "pnpm -C demo start:local-evaluator",
    "demo:local-jer": "pnpm -C demo start:local-jer",
    "pack-demo": "pnpm build && pnpm check:package",
    "demo:pack": "pnpm pack-demo && pnpm -C demo start:pack"
  },
  "peerDependencies": {
    "fig-tree-evaluator": "^3.0.0-preview.12",
    "json-edit-react": "^2.0.4",
    "react": ">=16.0.0"
  },
  "dependencies": {
    "@json-edit-react/components": "^1.1.0",
    "@json-edit-react/utils": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.13.1",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.19.0",
    "eslint-plugin-comment-length": "^2.3.1",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^5",
    "fig-tree-evaluator": "^3.0.0-preview.12",
    "globals": "^17.7.0",
    "jsdom": "^30.1.1",
    "json-edit-react": "^2.0.4",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.5",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8",
    "vitest": "^5.0.2"
  }
}
