{
  "name": "fig-tree-editor-react",
  "version": "3.0.0-dev",
  "private": true,
  "description": "React component for constructing FigTree Evaluator expressions",
  "main": "build/index.cjs.js",
  "module": "build/index.esm.js",
  "types": "build/index.d.ts",
  "author": "Carl Smith <5456533+CarlosNZ@users.noreply.github.com>",
  "repository": "git+https://github.com/CarlosNZ/fig-tree-editor-react.git",
  "files": [
    "build/**/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.8.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "build": "rimraf ./build && rollup -c && rimraf ./build/dts",
    "dev": "pnpm demo:local",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "pnpm build",
    "demo": "pnpm -C demo start",
    "demo:local": "pnpm -C demo dev",
    "demo:local-evaluator": "pnpm -C demo start:local-evaluator",
    "pack-demo": "node scripts/pack.mjs",
    "demo:pack": "pnpm pack-demo && pnpm -C demo start:pack"
  },
  "peerDependencies": {
    "fig-tree-evaluator": "^3.0.0-preview.1",
    "react": ">=16.0.0"
  },
  "dependencies": {
    "@json-edit-react/utils": "^1.0.0",
    "json-edit-react": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.5.1",
    "@types/react": "^18.2.20",
    "eslint": "^9.19.0",
    "eslint-plugin-comment-length": "^2.3.1",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^5",
    "fig-tree-evaluator": "^3.0.0-preview.1",
    "globals": "^17.7.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^5.0.7",
    "rollup": "^4.18.0",
    "rollup-plugin-bundle-size": "^1.0.3",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-sizes": "^1.0.6",
    "rollup-plugin-styles": "^4.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.1",
    "tslib": "^2.6.2",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.62.0"
  }
}
